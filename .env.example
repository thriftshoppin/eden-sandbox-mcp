# Copy to .env (gitignored) and fill in local values. Do not commit .env.

# Hostname only of your ngrok free static domain, or other tunnel host.
# No scheme and no /mcp path.
# Example: EXPECTED_HOST=your-static-domain.ngrok-free.dev
EXPECTED_HOST=

# Optional alias for EXPECTED_HOST if you prefer this name.
# NGROK_DOMAIN=

# Optional. Used only when ~/.config/ngrok/ngrok.yml is missing.
# Prefer: ngrok config add-authtoken <token>
# Do not paste the entire command line as the value of this variable.
# NGROK_AUTHTOKEN=

# Optional tunnel log verbosity (debug|info|warn|error). Default in scripts: debug.
# NGROK_LOG_LEVEL=info

# Optional display for desktop tools (this box uses :4).
# DISPLAY=:4
