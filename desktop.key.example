# Copy this file to desktop.key (mode 600). The server reads the key at
# startup and serves desktop tools only at /d/<key>/mcp.
#
# Generate a key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))" > desktop.key
#   chmod 600 desktop.key
#
# Never commit desktop.key or print the value in chat, issues, or docs.
REPLACE_WITH_A_LONG_RANDOM_TOKEN
